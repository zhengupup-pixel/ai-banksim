APP_NAME="AI BankSim API"
APP_ENV=development
DATABASE_URL=sqlite:///./ai_banksim.sqlite3
# Prefer `alembic upgrade head`. Enable only for temporary local prototypes.
AUTO_CREATE_TABLES=false
AUTH_TOKEN_TTL_HOURS=12
# Must be false outside local development/test environments.
ENABLE_DEV_SEED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
